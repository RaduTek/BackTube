{%- macro xmlns_attrs(namespaces=None) -%}
{%- set namespaces = namespaces or [
  ['', 'http://www.w3.org/2005/Atom'],
  ['media', 'http://search.yahoo.com/mrss/'],
  ['openSearch', 'http://a9.com/-/spec/opensearchrss/1.0/'],
  ['gd', 'http://schemas.google.com/g/2005'],
  ['yt', 'http://gdata.youtube.com/schemas/2007'],
] -%}
{%- for ns in namespaces %}
{%- if ns[0] %} xmlns:{{ ns[0] }}="{{ ns[1] }}"{% else %} xmlns="{{ ns[1] }}"{% endif -%}
{%- endfor -%}
{%- endmacro %}

{% macro atom_document(root='feed', namespaces=None) -%}
<?xml version="1.0" encoding="UTF-8"?>
<{{ root }}{{ xmlns_attrs(namespaces) }}>
{{ caller() }}
</{{ root }}>
{%- endmacro %}

{% macro atom_link(rel, href, type=None) -%}
{%- if href %}
  <link rel="{{ rel }}"{% if type %} type="{{ type }}"{% endif %} href="{{ href }}"/>
{%- endif %}
{%- endmacro %}

{% macro kind_category(kind='video') -%}
  <category scheme="http://schemas.google.com/g/2005#kind"
            term="http://gdata.youtube.com/schemas/2007#{{ kind }}"/>
{%- endmacro %}

{% macro feed_meta(
  feed_id,
  title,
  updated,
  kind='video',
  logo='http://www.youtube.com/img/pic_youtubelogo_123x63.gif',
  author_name='YouTube',
  author_uri='http://www.youtube.com/',
  generator='YouTube data API',
  generator_version='2.0',
  generator_uri='http://gdata.youtube.com/',
  links=None,
  total_results=0,
  start_index=1,
  items_per_page=20,
  author_display_name='',
  author_user_id=''
) -%}
  <id>{{ feed_id }}</id>
  <updated>{{ updated }}</updated>
  {{ kind_category(kind) }}
  <title type="text">{{ title }}</title>
  {%- if logo %}
  <logo>{{ logo }}</logo>
  {%- endif %}
  {%- for link in links or [] %}
  {{ atom_link(link.rel, link.href, link.get('type')) }}
  {%- endfor %}
  <author>
    <name>{{ author_name }}</name>
    {%- if author_display_name %}
    <displayName>{{ author_display_name }}</displayName>
    {%- endif %}
    {%- if author_uri %}
    <uri>{{ author_uri }}</uri>
    {%- endif %}
    {%- if author_user_id %}
    <yt:userId>{{ author_user_id }}</yt:userId>
    {%- endif %}
  </author>
  <generator version="{{ generator_version }}" uri="{{ generator_uri }}">{{ generator }}</generator>
  <openSearch:totalResults>{{ total_results }}</openSearch:totalResults>
  <openSearch:startIndex>{{ start_index }}</openSearch:startIndex>
  <openSearch:itemsPerPage>{{ items_per_page }}</openSearch:itemsPerPage>
{%- endmacro %}

{% macro video_author(video, base_url) -%}
{%- set handle = video.channel_handle or video.channel_id or video.channel_name -%}
    <author>
      <name>{{ handle }}</name>
      {%- if video.channel_name %}
      <displayName>{{ video.channel_name }}</displayName>
      {%- endif %}
      {%- if handle %}
      <uri>{{ base_url }}/feeds/api/users/{{ handle }}</uri>
      {%- endif %}
      {%- if video.channel_id %}
      <yt:userId>{{ video.channel_id }}</yt:userId>
      {%- endif %}
    </author>
{%- endmacro %}

{% macro video_media_group(video, base_url) -%}
{%- set duration = video.duration_seconds|default(0, true) -%}
{%- set contents = video.media_contents or [{'quality': 'medium', 'type': 'video/mp4', 'yt_format': 18, 'is_default': true}] -%}
{%- set thumbs = video.thumbnails or [] -%}
    <media:group>
      <media:title type="plain">{{ video.title }}</media:title>
      <media:description type="plain">{{ video.description }}</media:description>
      {%- if video.category %}
      <media:category label="{{ video.category_name or video.category }}"
                      scheme="http://gdata.youtube.com/schemas/2007/categories.cat">{{ video.category }}</media:category>
      {%- endif %}
      {%- if video.keywords %}
      <media:keywords>{{ video.keywords if video.keywords is string else video.keywords|join(', ') }}</media:keywords>
      {%- endif %}
      <media:player url="{{ base_url }}/watch?v={{ video.id }}"/>
      {%- for content in contents %}
      <media:content url="{{ content.url or (base_url ~ '/get_video?v=' ~ video.id ~ '&q=' ~ content.quality) }}"
                     type="{{ content.type|default('video/mp4') }}"
                     medium="video"
                     expression="full"
                     duration="{{ duration }}"
                     yt:format="{{ content.yt_format|default(18) }}"
                     {%- if content.is_default %} isDefault="true"{% endif %}/>
      {%- endfor %}
      {%- if thumbs %}
      {%- for thumb in thumbs %}
      <media:thumbnail url="{{ http_url(thumb.url) }}"
                       {%- if thumb.name %} yt:name="{{ thumb.name }}"{% endif %}
                       height="{{ thumb.height|default(360) }}"
                       width="{{ thumb.width|default(480) }}"
                       time="{{ thumb.time|default('00:00:00.000') }}"/>
      {%- endfor %}
      {%- elif video.thumbnail_url %}
      <media:thumbnail url="{{ http_url(video.thumbnail_url) }}"
                       height="360" width="480" time="00:00:00.000"/>
      {%- endif %}
      <yt:duration seconds="{{ duration }}"/>
      {%- if video.published %}
      <yt:uploaded>{{ video.published }}</yt:uploaded>
      {%- endif %}
      {%- if video.channel_id %}
      <yt:uploaderId>{{ video.channel_id }}</yt:uploaderId>
      {%- endif %}
      <yt:videoid id="{{ video.id }}">{{ video.id }}</yt:videoid>
      {%- if video.playlist_position %}
      <yt:position>{{ video.playlist_position }}</yt:position>
      {%- endif %}
      {%- if video.channel_name %}
      <media:credit role="uploader"
                    scheme="urn:youtube"
                    yt:display="{{ video.channel_name }}">{{ video.channel_handle or video.channel_id or video.channel_name }}</media:credit>
      {%- endif %}
    </media:group>
{%- endmacro %}

{% macro video_entry_body(video, base_url, updated='') -%}
{%- set ryd = video.rydratings|default({}, true) -%}
{%- set likes = ryd.likes if ryd.likes is defined else video.like_count|default(0, true) -%}
{%- set dislikes = ryd.dislikes if ryd.dislikes is defined else video.dislike_count|default(0, true) -%}
{%- set rating = ryd.rating if ryd.rating is defined else 0 -%}
{%- set comment_count = video.comment_count|default(0, true) -%}
    <id>{{ base_url }}/feeds/api/videos/{{ video.id }}</id>
    <youTubeId id="{{ video.id }}">{{ video.id }}</youTubeId>
    {%- if video.published %}
    <published>{{ video.published }}</published>
    {%- endif %}
    {%- if updated or video.published %}
    <updated>{{ updated or video.published }}</updated>
    {%- endif %}
    {{ kind_category('video') }}
    {%- if video.category %}
    <category scheme="http://gdata.youtube.com/schemas/2007/categories.cat"
              label="{{ video.category_name or video.category }}"
              term="{{ video.category }}">{{ video.category }}</category>
    {%- endif %}
    <title type="text">{{ video.title }}</title>
    <content type="text">{{ video.description }}</content>
    <link rel="alternate" type="text/html"
          href="{{ base_url }}/watch?v={{ video.id }}"/>
    <link rel="self" type="application/atom+xml"
          href="{{ base_url }}/feeds/api/videos/{{ video.id }}"/>
    <link rel="http://gdata.youtube.com/schemas/2007#video.related"
          type="application/atom+xml"
          href="{{ base_url }}/feeds/api/videos/{{ video.id }}/related"/>
    <link rel="http://gdata.youtube.com/schemas/2007#video.responses"
          type="application/atom+xml"
          href="{{ base_url }}/feeds/api/videos/{{ video.id }}/responses"/>
    {%- for link in video.links or [] %}
    {{ atom_link(link.rel, link.href, link.get('type')) }}
    {%- endfor %}
    {{ video_author(video, base_url) }}
    <gd:comments>
      <gd:feedLink href="{{ base_url }}/feeds/api/videos/{{ video.id }}/comments"
                   countHint="{{ comment_count }}"/>
    </gd:comments>
    {{ video_media_group(video, base_url) }}
    <gd:rating average="{{ '%.2f'|format(rating|float) }}"
               max="5" min="1"
               numRaters="{{ likes + dislikes }}"
               rel="http://schemas.google.com/g/2005#overall"/>
    <yt:statistics favoriteCount="0" viewCount="{{ video.view_count|default(0, true) }}"/>
    <yt:rating numLikes="{{ likes }}" numDislikes="{{ dislikes }}"/>
{%- endmacro %}

{% macro video_entry(video, base_url, updated='') -%}
  <entry>
{{ video_entry_body(video, base_url, updated) }}
  </entry>
{%- endmacro %}

{% macro comment_entry(comment, base_url) -%}
{%- set comment_id = comment.id or 'c' -%}
{%- set video_id = comment.video_id -%}
{%- set author_handle = comment.author_handle or comment.author_name -%}
{%- set author_ref = author_handle or comment.author_channel_id -%}
  <entry>
    <id>{{ base_url }}/feeds/api/videos/{{ video_id }}/comments/{{ comment_id }}</id>
    {%- if comment.published %}
    <published>{{ comment.published }}</published>
    {%- endif %}
    <updated>{{ comment.updated or comment.published }}</updated>
    {{ kind_category('comment') }}
    <title type="text">{{ comment.title or (comment.text|truncate(80, true, '...')) }}</title>
    <content type="text">{{ comment.text }}</content>
    <link rel="related" type="application/atom+xml"
          href="{{ base_url }}/feeds/api/videos/{{ video_id }}"/>
    <link rel="alternate" type="text/html"
          href="{{ base_url }}/watch?v={{ video_id }}"/>
    <link rel="self" type="application/atom+xml"
          href="{{ base_url }}/feeds/api/videos/{{ video_id }}/comments/{{ comment_id }}"/>
    <author>
      <name>{{ author_handle }}</name>
      {%- if comment.author_name %}
      <displayName>{{ comment.author_name }}</displayName>
      {%- endif %}
      {%- if author_ref %}
      <uri>{{ base_url }}/feeds/api/users/{{ author_ref }}</uri>
      {%- endif %}
      {%- if comment.author_channel_id %}
      <yt:userId>{{ comment.author_channel_id }}</yt:userId>
      {%- endif %}
    </author>
    {%- if comment.like_count is defined and comment.like_count != '' %}
    <yt:rating numLikes="{{ comment.like_count }}"/>
    {%- endif %}
    {%- if comment.reply_count is defined and comment.reply_count != '' %}
    <yt:replyCount>{{ comment.reply_count }}</yt:replyCount>
    {%- endif %}
  </entry>
{%- endmacro %}

{% macro user_entry_body(user, base_url) -%}
{%- set handle = user.channel_handle or user.channel_id -%}
  <id>{{ base_url }}/feeds/api/users/{{ handle }}</id>
  {%- if user.published %}
  <published>{{ user.published }}</published>
  {%- endif %}
  <updated>{{ user.updated }}</updated>
  {{ kind_category('userProfile') }}
  <category scheme="http://gdata.youtube.com/schemas/2007/channeltypes.cat"
            term=""/>
  <title type="text">{{ user.channel_name }} Channel</title>
  <content type="text">{{ user.description }}</content>
  <link rel="self" type="application/atom+xml"
        href="{{ base_url }}/feeds/api/users/{{ handle }}"/>
  <link rel="alternate" type="text/html"
        href="{{ base_url }}{{ user.channel_url }}"/>
  <author>
    <name>{{ handle }}</name>
    <displayName>{{ user.channel_name }}</displayName>
    <uri>{{ base_url }}/feeds/api/users/{{ handle }}</uri>
    <yt:userId>{{ user.channel_id }}</yt:userId>
  </author>
  <yt:description>{{ user.description }}</yt:description>
  <gd:feedLink rel="http://gdata.youtube.com/schemas/2007#user.uploads"
               href="{{ base_url }}/feeds/api/users/{{ handle }}/uploads"
               countHint="{{ user.video_count }}"/>
  <gd:feedLink rel="http://gdata.youtube.com/schemas/2007#user.playlists"
               href="{{ base_url }}/feeds/api/users/{{ handle }}/playlists"/>
  <gd:feedLink rel="http://gdata.youtube.com/schemas/2007#user.favorites"
               href="{{ base_url }}/feeds/api/users/{{ handle }}/favorites"/>
  <yt:statistics subscriberCount="{{ user.subscriber_count }}"
                 videoWatchCount="0"
                 viewCount="{{ user.view_count }}"
                 totalUploadViews="{{ user.view_count }}"/>
  {%- if user.thumbnail_url %}
  <media:thumbnail url="{{ http_url(user.thumbnail_url) }}"/>
  {%- endif %}
  <yt:username>{{ handle }}</yt:username>
  <yt:channelId>{{ user.channel_id }}</yt:channelId>
  {%- if user.country %}
  <yt:location>{{ user.country }}</yt:location>
  {%- endif %}
{%- endmacro %}

{% macro playlist_entry(playlist, base_url) -%}
{%- set handle = playlist.channel_handle or playlist.channel_id -%}
  <entry>
    <id>{{ base_url }}/feeds/api/users/{{ handle }}/playlists/{{ playlist.id }}</id>
    <playlistId>{{ playlist.id }}</playlistId>
    <yt:playlistId>{{ playlist.id }}</yt:playlistId>
    <updated>{{ playlist.updated }}</updated>
    {{ kind_category('playlistLink') }}
    <title type="text">{{ playlist.title }}</title>
    <content type="text"
             src="{{ base_url }}/feeds/api/users/{{ handle }}/playlists/{{ playlist.id }}">{{ playlist.description }}</content>
    <link rel="related" type="application/atom+xml"
          href="{{ base_url }}/feeds/api/users/{{ handle }}"/>
    <link rel="alternate" type="text/html"
          href="{{ base_url }}/playlist?list={{ playlist.id }}"/>
    <link rel="self" type="application/atom+xml"
          href="{{ base_url }}/feeds/api/users/{{ handle }}/playlists/{{ playlist.id }}"/>
    <author>
      <name>{{ handle }}</name>
      <displayName>{{ playlist.channel_name }}</displayName>
      <uri>{{ base_url }}/feeds/api/users/{{ handle }}</uri>
      <yt:userId>{{ playlist.channel_id }}</yt:userId>
    </author>
    <gd:feedLink rel="http://gdata.youtube.com/schemas/2007#playlist"
                 href="{{ base_url }}/feeds/api/users/{{ handle }}/playlists/{{ playlist.id }}"
                 countHint="{{ playlist.video_count }}"/>
    <yt:description>{{ playlist.description }}</yt:description>
    <yt:countHint>{{ playlist.video_count }}</yt:countHint>
    <summary>{{ playlist.description }}</summary>
    {%- if playlist.thumbnail_url %}
    <media:group>
      <media:thumbnail url="{{ http_url(playlist.thumbnail_url) }}"/>
    </media:group>
    {%- endif %}
  </entry>
{%- endmacro %}

{% macro playlist_feed_meta(playlist, base_url) -%}
  <summary>{{ playlist.description }}</summary>
  <content type="application/atom+xml;type=feed"
           src="{{ playlist.feed_url or (base_url ~ '/feeds/api/users/' ~ (playlist.channel_handle or playlist.channel_id) ~ '/playlists/' ~ playlist.id) }}"/>
  <yt:countHint>{{ playlist.video_count }}</yt:countHint>
  <yt:playlistId>{{ playlist.id }}</yt:playlistId>
  <playlistId>{{ playlist.id }}</playlistId>
  <media:group>
    <media:title type="plain">{{ playlist.title }}</media:title>
    <media:description type="plain">{{ playlist.description }}</media:description>
    {%- if playlist.thumbnail_url %}
    <media:thumbnail url="{{ http_url(playlist.thumbnail_url) }}"/>
    {%- endif %}
  </media:group>
{%- endmacro %}

{% macro event_entry(event, base_url) -%}
  <entry>
    <id>{{ base_url }}/feeds/api/events/{{ event.type }}/{{ event.video.id }}</id>
    <updated>{{ event.updated }}</updated>
    {{ kind_category('userEvent') }}
    <category scheme="http://gdata.youtube.com/schemas/2007/userevents.cat"
              term="{{ event.type }}"/>
    <title type="text">{{ event.title }}</title>
    <yt:videoid>{{ event.video.id }}</yt:videoid>
    <yt:username>{{ event.author_handle }}</yt:username>
    <yt:groupId>0</yt:groupId>
    <author>
      <name>{{ event.author_handle }}</name>
      <displayName>{{ event.author_name }}</displayName>
      <uri>{{ base_url }}/feeds/api/users/{{ event.author_handle }}</uri>
      <yt:userId>{{ event.author_channel_id }}</yt:userId>
    </author>
    <link rel="http://gdata.youtube.com/schemas/2007#video"
          type="application/atom+xml"
          href="{{ base_url }}/feeds/api/videos/{{ event.video.id }}">
{{ video_entry(event.video, base_url, event.updated) }}
    </link>
  </entry>
{%- endmacro %}
